   "metadata": {},
   "source": [
    "## 3. Future Employment Outlook \n",
    "*Analysis of the current Data Scientist job market and future trends.*"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "0be86653",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = pd.read_csv('Data/data_science.csv')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "921ac37d",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = data[~data[\"Industry Title\"].isin([\n",
    "    \"Total, all industries\",\n",
    "    \"Total wage and salary employment\"\n",
    "])]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3158b8bf",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = pd.read_csv('data_science.csv')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "b07beb0a",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x800 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "top10_industries_by_jobs = (\n",
    "    data\n",
    "        .groupby(\"Industry Title\")[\"2024 Employment\"]\n",
    "        .sum()\n",
    "        .sort_values(ascending=False)\n",
    "        .head(10))\n",
    "top10_industries_by_jobs\n",
    "\n",
    "top10_industries_by_jobs_2034 = (\n",
    "    data\n",
    "        .groupby(\"Industry Title\")[\"Projected 2034 Employment\"]\n",
    "        .sum()\n",
    "        .sort_values(ascending=False)\n",
    "        .head(10))\n",
    "top10_industries_by_jobs_2034\n",
    "\n",
    "combined = pd.merge(\n",
    "    top10_industries_by_jobs.reset_index(),\n",
    "    top10_industries_by_jobs_2034.reset_index(),\n",
    "    on=\"Industry Title\",\n",
    "    suffixes=(\" 2024\", \" 2034\")\n",
    ")\n",
    "\n",
    "combined = combined.rename(columns={\n",
    "    combined.columns[1]: \"Employment 2024\",\n",
    "    combined.columns[2]: \"Employment 2034\"\n",
    "})\n",
    "\n",
    "rename_dict = {\n",
    "    \"Professional, scientific, and technical services\": \"Prof./Sci./Tech Services\",\n",
    "    \"Management of companies and enterprises\": \"Mgmt of Companies & Enterprises\",\n",
    "    \"Finance and insurance\": \"Finance & Insurance\",\n",
    "    \"Computer systems design and related services\": \"Computer Systems Design & Services\",\n",
    "    \"Publishing, broadcasting, and content providers\": \"Publishing & Broadcasting\",\n",
    "    \"Insurance carriers and related activities\": \"Insurance Carriers (Related)\",\n",
    "    \"Educational services; state, local, and private\": \"Educational Services\",\n",
    "    \"Monetary authorities - central bank, and credit intermediation and related activities\":\n",
    "        \"Monetary Authorities & Credit\",\n",
    "}\n",
    "\n",
    "combined[\"Industry Title\"] = combined[\"Industry Title\"].replace(rename_dict)\n",
    "\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "plt.rcParams['font.family'] = 'DejaVu Sans'\n",
    "# Sort industries so bars appear in a consistent order\n",
    "combined_sorted = combined.sort_values(\"Employment 2024\")\n",
    "\n",
    "y = np.arange(len(combined_sorted))\n",
    "height = 0.45  # bar thickness\n",
    "\n",
    "plt.figure(figsize=(9, 5))\n",
    "\n",
    "# Blue and red bars\n",
    "plt.barh(\n",
    "    y - height/2,\n",
    "    combined_sorted[\"Employment 2024\"],\n",
    "    height,\n",
    "    color=\"steelblue\",\n",
    "    label=\"2024\",\n",
    ")\n",
    "plt.barh(\n",
    "    y + height/2,\n",
    "    combined_sorted[\"Employment 2034\"],\n",
    "    height,\n",
    "    color=\"firebrick\",\n",
    "    label=\"2034 Projection\",\n",
    ")\n",
    "\n",
    "# Larger axis labels\n",
    "plt.xlabel(\"Employment (in thousands)\", fontsize=16)\n",
    "plt.ylabel(\"Industry\", fontsize=16)\n",
    "\n",
    "plt.title(\"2024 vs 2034 Projected Employment by Industry\", fontsize=18)\n",
    "\n",
    "# Y-axis labels\n",
    "plt.yticks(y, combined_sorted[\"Industry Title\"], fontsize=12)\n",
    "\n",
    "# Add gridlines (vertical since it's horizontal bars)\n",
    "plt.grid(axis=\"x\", linestyle=\"--\", alpha=0.6)\n",
    "\n",
    "plt.legend(fontsize=14)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  }
